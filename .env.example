# ============================================================
# PERFIL JURÍDICO Y PATRIMONIAL — Sánchez & Cárdenas Consulting S.A.S.
# Variables de entorno. En Render: servicio → Environment.
# Nunca suba los valores reales a GitHub.
# ============================================================

# Dirección pública del servicio (sin barra al final)
PUBLIC_BASE_URL=https://perfil-juridico-pruebas.onrender.com

# Twilio (WhatsApp) — ya existen en Render
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Wompi — las dos primeras ya existen en Render
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_KEY=
# NUEVAS: Wompi → Desarrolladores → Secretos para integración técnica
WOMPI_EVENTS_SECRET=
WOMPI_PRIVATE_KEY=

# Supabase (proyecto monitor-judicial) — Project Settings → Data API y API Keys
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Clave de la herramienta interna (https://.../admin). Use una larga y difícil.
ADMIN_CLAVE=

# Condiciones del servicio
PRECIO_CENTAVOS=5000000
HORAS_ENTREGA_SNR=12
POLITICA_DATOS_URL=

# Aviso por correo a la firma cuando entra un pago (Resend, opcional)
RESEND_API_KEY=
EMAIL_FIRMA=gerenciasanchezcardenas@gmail.com
EMAIL_REMITENTE=

# SECOP: token opcional de datos.gov.co para más consultas por hora
SECOP_APP_TOKEN=
